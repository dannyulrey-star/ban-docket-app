# Copy this file to a new file named ".env" in the same folder,
# then fill in your real MongoDB connection string.
# NEVER commit your real .env file to GitHub - it's already listed in .gitignore.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/bandocket?retryWrites=true&w=majority
PORT=3001

# The exact origin of your deployed frontend (no trailing slash), e.g.
# https://ban-list.vercel.app - only this origin will be allowed by CORS,
# and it's where we send people back to after they log in with Discord.
FRONTEND_ORIGIN=<your-deployed-frontend-url>

# ---- LOGIN (DISCORD OAUTH) ----
# Real Riot Games login isn't available to small apps like this one (Riot
# only approves it for products it has manually reviewed), so this app logs
# people in with Discord instead - same "prove you are who you say" result,
# but self-serve. To get these two values:
#   1. Go to https://discord.com/developers/applications and click "New Application".
#   2. Open the "OAuth2" tab. Copy the Client ID and Client Secret below.
#   3. Under "Redirects", add the exact value of DISCORD_REDIRECT_URI below
#      (for local dev: http://localhost:3001/api/auth/discord/callback).
DISCORD_CLIENT_ID=<from-the-discord-developer-portal>
DISCORD_CLIENT_SECRET=<from-the-discord-developer-portal>
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback

# Signs the login cookie so it can't be forged. Make it long and random -
# anyone who has this value could forge a login as anyone. Change it and
# everyone gets logged out.
SESSION_SECRET=<make-up-a-long-random-string>
