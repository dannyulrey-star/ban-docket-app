# Copy this to a file named ".env" (for local dev) and later set the real
# value in Vercel's dashboard when you deploy (pointing at your Render backend URL).
VITE_API_URL=http://localhost:3001

# Must match the backend's GROUP_SECRET exactly, or filing/lifting bans will
# get a 401. This ends up in the built frontend bundle, so it's not a strong
# secret - just a "know the group password" gate, not real authentication.
VITE_GROUP_SECRET=<same-value-as-backend-GROUP_SECRET>
